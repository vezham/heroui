    "react-dom": ">=18 || >=19.0.0-rc.0"
  },
  "dependencies": {
    "@internationalized/date": "3.8.2",
    "@vx-oss/aria-utils": "workspace:*",
    "@vx-oss/button": "workspace:*",
    "@vx-oss/calendar": "workspace:*",
    "@vx-oss/date-input": "workspace:*",
    "@vx-oss/form": "workspace:*",
    "@vx-oss/popover": "workspace:*",
    "@vx-oss/react-utils": "workspace:*",
    "@vx-oss/shared-icons": "workspace:*",
    "@vx-oss/shared-utils": "workspace:*",
    "@react-aria/datepicker": "3.15.0",
    "@react-aria/i18n": "3.12.11",
    "@react-stately/datepicker": "3.15.0",
    "@react-stately/utils": "3.10.8",
    "@react-types/datepicker": "3.13.0",
    "@react-types/shared": "3.31.0"
  },
  "devDependencies": {
    "@vx-oss/radio": "workspace:*",
    "@vx-oss/system": "workspace:*",
    "@vx-oss/test-utils": "workspace:*",
    "@vx-oss/theme": "workspace:*",
    "framer-motion": "11.18.2",
    "clean-package": "2.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0"
  },
  "clean-package": "../../../clean-package.config.json"

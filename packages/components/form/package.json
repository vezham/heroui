{
  "name": "@vx-oss/form",
  "version": "0.1.7",
  "description": "A form is a group of inputs that allows users submit data to a server and supports field validation errors.",
  "keywords": [
    "form"
  ],
  "author": "Vx OSS Devs <oss-developers@vezham.com>",
  "homepage": "https://vezham.com",
  "license": "MIT",
  "main": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",

    "@vx-oss/shared-utils": "workspace:*",
    "@vx-oss/use-safe-layout-effect": "workspace:*",
    "@react-aria/focus": "3.21.0",
    "@react-aria/interactions": "3.25.4",
    "@react-aria/textfield": "3.18.0",
    "@react-stately/utils": "3.10.8",

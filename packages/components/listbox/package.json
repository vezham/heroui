    "@vx-oss/system": ">=0.0.0"
  },
  "dependencies": {
    "@vx-oss/aria-utils": "workspace:*",
    "@vx-oss/divider": "workspace:*",
    "@vx-oss/react-utils": "workspace:*",
    "@vx-oss/shared-utils": "workspace:*",
    "@vx-oss/use-is-mobile": "workspace:*",
    "@tanstack/react-virtual": "3.11.3",
    "@react-aria/listbox": "3.14.7",
    "@react-stately/list": "3.12.4",
    "@react-aria/focus": "3.21.0",
    "@react-aria/interactions": "3.25.4",
    "@react-types/shared": "3.31.0"
  },
  "devDependencies": {
    "@vx-oss/avatar": "workspace:*",
    "@vx-oss/chip": "workspace:*",
    "@vx-oss/scroll-shadow": "workspace:*",
    "@vx-oss/shared-icons": "workspace:*",
    "@vx-oss/stories-utils": "workspace:*",
    "@vx-oss/system": "workspace:*",
    "@vx-oss/theme": "workspace:*",
    "clean-package": "2.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0"
  },
  "clean-package": "../../../clean-package.config.json"

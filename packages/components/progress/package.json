    "@v0xoss/use-is-mounted": "workspace:*",
    "@react-aria/i18n": "3.12.5",
    "@react-aria/progress": "3.4.19",
    "@react-aria/utils": "3.27.0",
    "@react-types/progress": "3.5.9"
  },
  "devDependencies": {
    "@v0xoss/theme": "workspace:*",
    "@v0xoss/system": "workspace:*",
    "@v0xoss/card": "workspace:*",
    "@v0xoss/chip": "workspace:*",
    "clean-package": "2.2.0",

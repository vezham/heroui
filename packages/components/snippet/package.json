{
  "name": "@vx-oss/snippet",
  "version": "0.0.1",
  "description": "Display a snippet of copyable code for the command line.",
  "keywords": [
    "snippet"
  ],
  "author": "Vx OSS Devs <oss-developers@vezham.com>",
  "homepage": "https://vezham.com",
  "license": "MIT",
  "main": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vezham/heroui.git",
    "directory": "packages/components/snippet"
  },
  "bugs": {
    "url": "https://github.com/vezham/heroui/issues"
  },
  "scripts": {
    "build": "tsup src --dts",
    "dev": "pnpm build:fast --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build:fast": "tsup src",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=18 || >=19.0.0-rc.0",
    "react-dom": ">=18 || >=19.0.0-rc.0",
    "framer-motion": ">=11.5.6 || >=12.0.0-alpha.1",
    "@vx-oss/theme": ">=0.0.0",
    "@vx-oss/system": ">=0.0.0"
  },
  "dependencies": {
    "@vx-oss/button": "workspace:*",
    "@vx-oss/shared-utils": "workspace:*",
    "@vx-oss/react-utils": "workspace:*",
    "@vx-oss/shared-icons": "workspace:*",
    "@vx-oss/use-clipboard": "workspace:*",
    "@vx-oss/tooltip": "workspace:*",
    "@react-aria/focus": "3.21.0"
  },
  "devDependencies": {
    "@vx-oss/theme": "workspace:*",
    "@vx-oss/system": "workspace:*",
    "framer-motion": "11.18.2",
    "clean-package": "2.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0"
  },
  "clean-package": "../../../clean-package.config.json"
}

{
  "name": "@vx-oss/spacer",
  "version": "0.0.7",
  "description": "A flexible spacer component designed to create consistent spacing and maintain alignment in your layout.",
  "keywords": [
    "spacer"
  ],
  "author": "Vx OSS Devs <oss-developers@vezham.com>",
  "homepage": "https://vezham.com",
  "license": "MIT",
  "main": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vezham/heroui.git",
    "directory": "packages/components/spacer"
  },
  "bugs": {
    "url": "https://github.com/vezham/heroui/issues"
  },
  "scripts": {
    "build": "tsup src --dts",
    "build:fast": "tsup src",
    "dev": "pnpm build:fast --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=18 || >=19.0.0-rc.0",
    "react-dom": ">=18 || >=19.0.0-rc.0",
    "@vx-oss/theme": ">=0.0.0"
  },
  "dependencies": {
    "@vx-oss/system-rsc": "workspace:*",
    "@vx-oss/shared-utils": "workspace:*",
    "@vx-oss/react-utils": "workspace:*"
  },
  "devDependencies": {
    "@vx-oss/theme": "workspace:*",
    "@vx-oss/test-utils": "workspace:*",
    "clean-package": "2.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0"
  },
  "clean-package": "../../../clean-package.config.json"
}

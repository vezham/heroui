  },
  "dependencies": {
    "@v0xoss/react-utils": "workspace:*",
    "@v0xoss/shared-utils": "workspace:*",
    "@v0xoss/shared-icons": "workspace:*",
    "@v0xoss/use-is-mobile": "workspace:*",
    "@v0xoss/spinner": "workspace:*",
    "@react-aria/toast": "3.0.0-beta.19",
    "@react-aria/utils": "3.27.0",

{
  "name": "@vezham/stories-utils",
  "version": "0.0.2",
  "description": "A list of utilities for storybook' stories.",
  "keywords": [
    "stories-utils"
  ],
  "author": "Junior Garcia <jrgarciadev@gmail.com>",
  "homepage": "https://heroui.com",
  "license": "MIT",
  "main": "dist/index.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vezham/heroui.git",
    "directory": "packages/utilities/stories-utils"
  },
  "bugs": {
    "url": "https://github.com/vezham/heroui/issues"
  },
  "scripts": {
    "build": "tsup src --dts",
    "build:fast": "tsup src",
    "dev": "pnpm build:fast --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "clean-package": "../../../clean-package.config.json",
  "tsup": {
    "clean": true,
    "target": "es2019",
    "format": [
      "cjs",
      "esm"
    ]
  },
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
